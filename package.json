{
  "name": "zlog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @zlog/web dev",
    "dev:watch": "pnpm --filter @zlog/web dev:watch",
    "build": "pnpm --filter @zlog/web build",
    "build:desktop": "NEXT_DESKTOP=true pnpm --filter @zlog/web build",
    "export": "pnpm --filter @zlog/web export",
    "start": "pnpm --filter @zlog/web start",
    "lint": "pnpm --filter @zlog/web lint",
    "typecheck": "pnpm --filter @zlog/web typecheck",
    "check": "pnpm lint && pnpm typecheck",
    "create-admin": "node scripts/create-admin.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.14.0+sha512.66c1ac4c7d4762d6d7dde44c7f3e5a73591ed0a0806e751d4ed32d4f004f25b2285a906b1fd8a9e3e621df3b4e2858bf88e50e0cf626bedbe977fe434a5caf85"
}

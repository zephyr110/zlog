# Admin credentials (for local development)
# Generate password hash with:
#   node -e "const bcrypt = require('bcryptjs'); bcrypt.hash('your-password', 10).then(h => console.log(Buffer.from(h).toString('base64')))"
# The hash is stored base64-encoded to avoid $-expansion issues in .env files.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=JDJiJDEwJE1MWnpaalE1N0lxWHh2T0IyUFBRemVmYnQ2UXhTaEZURWtLc09hVHhJb2dhcnRYd1poUlc=

# Session secret (generate with: openssl rand -hex 32)
# NOTE: generate a REAL random value — the placeholder below is public
# knowledge and would let anyone forge admin JWTs and comment sessions
# if deployed as-is. Kept commented so a plain `cp` of this file never
# ships the constant.
# SESSION_SECRET=change-me-to-a-random-string

# ── Guest comments — Cloudflare Turnstile (anti-spam) ──
# Production: create a Turnstile widget at https://dash.cloudflare.com →
# Turnstile → Add site. Put the sitekey (public) and secret key here.
# IMPORTANT: the widget's Domains list must include your production
# domain (e.g. zephyr110.vercel.app) — any other host triggers widget
# error 110200 ("domain is not allowed"). Add "localhost" there too if
# you want the real key to work in local dev.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAA...
#
# Local development — use Cloudflare's public test keys instead (they
# load on any domain and always pass verification). WARNING: never
# deploy these — the always-pass key silently disables the spam gate in
# production. Uncomment only for local dev.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Test keys that force a failure (to exercise the rejected path):
#   sitekey 2x00000000000000000000AB + secret 2x0000000000000000000000000000000AA (always blocks)
#   sitekey 3x00000000000000000000FF (forces interactive challenge)

# Site URL (used for SEO metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google Analytics 4 ──
# Public measurement ID (G-XXXXXXXX) — enables the gtag snippet site-wide.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
#
# Server-only — admin dashboard Traffic reports (GA4 Data API).
# Property ID is the numeric media-resource ID (Admin → Property settings),
# NOT the Measurement ID and NOT the data-stream ID.
# Create a GCP service account, enable "Google Analytics Data API", download
# a JSON key, and add the service account email as Viewer on the GA4 property.
# GA_PROPERTY_ID=123456789
# GA_CLIENT_EMAIL=zlog-ga4@your-project.iam.gserviceaccount.com
# Paste private_key from the JSON; keep \n escapes as a single line in .env:
# GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Optional local HTTP/SOCKS proxy used only after a direct Google API
# call fails (desktop also reads the OS/VPN system proxy). Leave unset
# on Vercel. Restart `pnpm dev` after changing.
# If the IDE already set HTTPS_PROXY to a dead loopback port, this file
# is still read and unreachable loopback proxies are skipped.
# HTTPS_PROXY=http://127.0.0.1:<port>
# HTTP_PROXY=http://127.0.0.1:<port>

# ── Vercel Web Analytics (optional second Traffic source) ──
# Create a token: Vercel → Account Settings → Tokens (scope: read).
# Project ID: Project → Settings → General. Team ID: Team Settings
# (omit VERCEL_ANALYTICS_TEAM_ID for a personal account).
# VERCEL_API_TOKEN=vercel_xxx
# VERCEL_ANALYTICS_PROJECT_ID=prj_xxx
# VERCEL_ANALYTICS_TEAM_ID=team_xxx

# Turso database (libSQL) — REQUIRED
# For local development without Turso Cloud, use a local SQLite file:
TURSO_DATABASE_URL=file:./bitlog.db
# For remote Turso, create a database at https://turso.tech:
#   turso db create bitlog
#   turso db show bitlog --url        -> the libsql:// URL
#   turso db tokens create bitlog     -> the auth token
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Media dual-write (Turso authoritative store + GitHub/jsdelivr delivery) ──
# Required for image uploads. Generate a fine-grained token at:
#   GitHub → Settings → Developer settings → Fine-grained personal access tokens →
#   Repository access → only zephyr110/blog-img → Permissions → Contents: Read and write
BLOG_IMG_GITHUB_TOKEN=github_pat_xxx
# GitHub repo used as the CDN delivery layer
BLOG_IMG_REPO=zephyr110/blog-img
# Branch of the repo to push to (normal commits only, branch protection safe)
BLOG_IMG_BRANCH=main
# jsdelivr CDN base — swap to fastly.jsdelivr.net / gcore.jsdelivr.net as needed
BLOG_IMG_CDN_BASE=https://cdn.jsdelivr.net/gh/zephyr110/blog-img
# WebP compression quality (1-100, default 80)
BLOG_IMG_QUALITY=80

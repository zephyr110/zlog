    "@vercel/analytics": "^2.0.1",
    "@zlog/auth": "workspace:*",
    "@zlog/core": "workspace:*",
    "@zlog/database": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotted-map": "^3.1.0",
